diff --git a/excalidraw-app/components/BoardsDialog.tsx b/excalidraw-app/components/BoardsDialog.tsx
new file mode 100644
index 0000000..4becc9e
--- /dev/null
+++ b/excalidraw-app/components/BoardsDialog.tsx
@@ -0,0 +1,124 @@
+import React, { useCallback, useEffect, useState } from "react";
+import { Dialog } from "@excalidraw/excalidraw/components/Dialog";
+import type { Board } from "../data/boards";
+import {
+  deleteBoard,
+  getBoardLink,
+  listBoards,
+  renameBoard,
+} from "../data/boards";
+
+import "./BoardsDialog.scss";
+
+const formatDate = (timestamp: number) =>
+  new Date(timestamp).toLocaleString(undefined, {
+    dateStyle: "medium",
+    timeStyle: "short",
+  });
+
+export const BoardsDialog = ({
+  onClose,
+  currentRoomId,
+}: {
+  onClose: () => void;
+  currentRoomId: string | null;
+}) => {
+  const [boards, setBoards] = useState<Board[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const refresh = useCallback(async () => {
+    try {
+      setBoards(await listBoards());
+      setError(null);
+    } catch (err: any) {
+      setError(err.message);
+    }
+  }, []);
+
+  useEffect(() => {
+    refresh();
+  }, [refresh]);
+
+  const openBoard = (board: Board) => {
+    window.location.href = getBoardLink(board);
+    window.location.reload();
+  };
+
+  const onRename = async (board: Board) => {
+    const name = window.prompt("Board name", board.name);
+    if (name === null || !name.trim()) {
+      return;
+    }
+    try {
+      await renameBoard(board.roomId, name.trim());
+      await refresh();
+    } catch (err: any) {
+      setError(err.message);
+    }
+  };
+
+  const onDelete = async (board: Board) => {
+    if (
+      !window.confirm(
+        `Remove "${board.name}" from this list? The drawing itself isn't deleted — anyone with its link can still open it.`,
+      )
+    ) {
+      return;
+    }
+    try {
+      await deleteBoard(board.roomId);
+      await refresh();
+    } catch (err: any) {
+      setError(err.message);
+    }
+  };
+
+  return (
+    <Dialog onCloseRequest={onClose} title="Boards" size="small">
+      <div className="BoardsDialog">
+        <p className="BoardsDialog__hint">
+          Every live-collaboration room opened on this server shows up here,
+          most recent first.
+        </p>
+        {error && <p className="BoardsDialog__error">{error}</p>}
+        {boards === null && !error && <p>Loading…</p>}
+        {boards?.length === 0 && (
+          <p>No boards yet — start a live collaboration session to add one.</p>
+        )}
+        {boards && boards.length > 0 && (
+          <ul className="BoardsDialog__list">
+            {boards.map((board) => (
+              <li key={board.roomId} className="BoardsDialog__item">
+                <button
+                  type="button"
+                  className="BoardsDialog__open"
+                  onClick={() => openBoard(board)}
+                  disabled={board.roomId === currentRoomId}
+                  title={
+                    board.roomId === currentRoomId
+                      ? "You're on this board"
+                      : "Open this board"
+                  }
+                >
+                  <span className="BoardsDialog__name">
+                    {board.name}
+                    {board.roomId === currentRoomId && " (current)"}
+                  </span>
+                  <span className="BoardsDialog__meta">
+                    Last opened {formatDate(board.lastOpenedAt)}
+                  </span>
+                </button>
+                <button type="button" onClick={() => onRename(board)}>
+                  Rename
+                </button>
+                <button type="button" onClick={() => onDelete(board)}>
+                  Remove
+                </button>
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    </Dialog>
+  );
+};
diff --git a/excalidraw-app/data/boards.ts b/excalidraw-app/data/boards.ts
new file mode 100644
index 0000000..1224310
--- /dev/null
+++ b/excalidraw-app/data/boards.ts
@@ -0,0 +1,47 @@
+import { getCollaborationLink } from ".";
+
+export type Board = {
+  roomId: string;
+  roomKey: string;
+  name: string;
+  createdAt: number;
+  lastOpenedAt: number;
+};
+
+const BOARDS_URL = `${import.meta.env.VITE_APP_HTTP_STORAGE_BACKEND_URL}/boards`;
+
+export const isBoardsEnabled = () =>
+  import.meta.env.VITE_APP_STORAGE_BACKEND === "http";
+
+const request = async <T>(path: string, init?: RequestInit): Promise<T> => {
+  const response = await fetch(`${BOARDS_URL}${path}`, {
+    ...init,
+    headers: { "Content-Type": "application/json", ...init?.headers },
+  });
+  if (!response.ok) {
+    throw new Error(`Boards request failed (${response.status})`);
+  }
+  return response.json();
+};
+
+export const listBoards = () => request<Board[]>("");
+
+export const recordBoard = (roomId: string, roomKey: string) =>
+  request<Board>(`/${encodeURIComponent(roomId)}`, {
+    method: "PUT",
+    body: JSON.stringify({ roomKey, touch: true }),
+  });
+
+export const renameBoard = (roomId: string, name: string) =>
+  request<Board>(`/${encodeURIComponent(roomId)}`, {
+    method: "PUT",
+    body: JSON.stringify({ name }),
+  });
+
+export const deleteBoard = (roomId: string) =>
+  request<{ roomId: string }>(`/${encodeURIComponent(roomId)}`, {
+    method: "DELETE",
+  });
+
+export const getBoardLink = (board: Board) =>
+  getCollaborationLink({ roomId: board.roomId, roomKey: board.roomKey });
